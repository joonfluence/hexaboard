{
  "name": "to-do-app",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate:api": "turbo run build --filter=@todo/bootstrap-http && pnpm --filter @todo/bootstrap-http openapi && pnpm --filter @todo/api-client generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.12",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
