{
  "name": "@todo/bootstrap-http",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@todo/application": "workspace:*",
    "@todo/domain": "workspace:*",
    "@todo/persistence": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "dev": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/main.js",
    "migrate": "node dist/migrate.js",
    "openapi": "node dist/openapi/generate.js ../../packages/api-client/openapi.json"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@testcontainers/postgresql": "^12.1.0",
    "testcontainers": "^12.1.0"
  }
}
