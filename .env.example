# 값은 비워 둔다. 로컬 개발용 값은 .env에 적고 .env는 커밋하지 않는다.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# 관리형 DB가 SSL을 요구하면 true. 로컬 docker-compose는 비워 둔다.
DATABASE_SSL=
PORT=
# 브라우저(웹 앱)가 서버를 직접 호출할 때 허용할 오리진. 쉼표로 구분한다. 비우면 허용하지 않는다.
CORS_ALLOWED_ORIGINS=
# false면 기동 시 마이그레이션을 건너뛴다(배포 전 단계에서 `node dist/migrate.js`로 실행). 비우면 기동 시 실행한다.
MIGRATE_ON_START=
# 웹(apps/web)이 호출할 서버 주소. 빌드 시점에 값이 박히므로 Vercel에서는 빌드 전에 설정한다. 예: http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
# 웹 오류·성능을 보낼 Grafana Faro 수집 주소(브라우저에 노출되는 공개 값). 비우면 수집하지 않는다.
NEXT_PUBLIC_FARO_URL=
# 서버 OpenTelemetry(OTLP) 전송. 엔드포인트를 비우면 계측이 꺼진다(로컬·테스트).
# Grafana Cloud 포털의 OpenTelemetry 설정에서 값을 받는다. 헤더에는 토큰이 들어가므로 Render 대시보드에만 넣고 커밋하지 않는다.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
